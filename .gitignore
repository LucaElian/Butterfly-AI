# Python / local environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Butterfly personal/runtime state
.butterfly/butterfly.db
.butterfly/butterfly.db-*
.butterfly/*.sqlite
.butterfly/*.sqlite-*
.butterfly/pipeline_state.json
.butterfly/current_experiment.json
.butterfly/experiment_history.json
.butterfly/backups/

# Physical brains are local/release artifacts, not normal Git history
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors
models/*.safetensors.json
models/registry.json
!models/.gitkeep
!models/history.json

# Temporary training state
training_state/

# Pipeline runtime output
logs/
reports/

# Generated large corpora. Keep stable source metadata, not generated books.
data/corpus/*.txt
data/corpus/*.part
data/corpus/wikipedia_seen.txt
data/corpus/wikipedia_sources.jsonl
data/corpus/v*/
!data/corpus/manifest.json

# Deliberate-learning working corpus is generated locally.
data/corpus/deliberate/*.jsonl
data/corpus/deliberate/manifest.json
data/corpus/deliberate/history.json

# Generated/optional release bundles
release/

# OS/editor
.DS_Store
Thumbs.db
.vs/
