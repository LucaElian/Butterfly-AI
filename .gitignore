# Python / local environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Butterfly runtime state: personal/local, not source code
.butterfly/butterfly.db
.butterfly/butterfly.db-*
.butterfly/*.sqlite
.butterfly/*.sqlite-*

# Physical brains are release artifacts, not Git history
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors
models/*.safetensors.json
models/registry.json

# Temporary training state may be ~3x the weight size because Adam has moments
training_state/

# Generated large corpora. Keep corpus builder + small manifest in Git, not the books themselves.
data/corpus/*.txt
data/corpus/*.part
data/corpus/wikipedia_seen.txt
data/corpus/wikipedia_sources.jsonl

# Generated/optional release bundles
release/

# OS/editor
.DS_Store
Thumbs.db
.vs/
