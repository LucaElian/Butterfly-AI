{
  "schema_version": 2,
  "default_recipe": "intent_routing",
  "allow_sleep_learning": false,
  "runtime": {
    "cpu_thread_fraction": 0.67
  },
  "stages": {
    "prepare": [
      "-m",
      "butterfly.deliberate",
      "prepare"
    ],
    "build_dataset": [
      "-m",
      "butterfly.deliberate",
      "build"
    ],
    "train": [
      "-m",
      "butterfly.deliberate",
      "train"
    ],
    "evaluate_and_promote": [
      "-m",
      "butterfly.deliberate",
      "evaluate"
    ]
  }
}
