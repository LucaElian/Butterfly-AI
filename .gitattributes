# Legacy/milestone binary patterns may still be handled by LFS if explicitly forced into Git.
# Normal Butterfly brains are ignored by .gitignore and should be uploaded as GitHub Release assets.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
